generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  HOME
  COMPANY
  STORE
  RESTAURANT
}

enum OrderStatus {
  PENDING
  PREPARING
  ON_ROUTE
  DELIVERED
  CANCELLED
}

enum ContainerMovementType {
  OUT_FULL
  IN_EMPTY
  ADJUSTMENT
}

// Un rol es una fila, no un valor de enum: se crean y se editan desde Configuración ›
// Roles y permisos, sin tocar el código. Antes era el enum `RoleName`, y por eso agregar un
// puesto nuevo obligaba a una migración y a un despliegue.
model Role {
  id          String  @id @default(cuid())
  // Identificador estable que NO cambia al renombrar el rol. Los cinco que trae el sistema
  // conservan la clave que tenía el enum (ADMIN, SELLER, ...), así los datos viejos y los
  // tokens emitidos antes de la migración siguen valiendo.
  clave       String  @unique @db.VarChar(40)
  nombre      String  @unique @db.VarChar(60)
  descripcion String? @db.VarChar(250)
  // Un rol del sistema no se puede eliminar ni cambiar de clave: hay código que depende de
  // que existan (el seed, y el administrador que tiene que poder entrar siempre).
  sistema     Boolean @default(false)
  // Lo puede todo, incluidos los permisos que se agreguen al catálogo después. Con una lista
  // fija de permisos, el administrador se quedaría afuera de cada función nueva.
  accesoTotal Boolean @default(false) @map("acceso_total")
  estado      Boolean @default(true)

  permisos  RolPermiso[]
  users     User[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("roles")
}

// Un permiso otorgado a un rol. La `clave` sale del catálogo de `apps/api/src/auth/permisos.ts`,
// que es donde se declara qué permisos existen; acá solo se guarda quién los tiene.
//
// A propósito NO hay clave foránea contra una tabla de permisos: el catálogo vive en el código
// porque cada permiso necesita que alguien lo consulte en un endpoint, y una fila suelta en la
// base no habilitaría nada. Una clave que ya no exista en el catálogo se ignora al leer.
model RolPermiso {
  roleId    String   @map("role_id")
  clave     String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, clave])
  @@index([roleId])
  @@map("rol_permiso")
}

model User {
  id               String                 @id @default(cuid())
  name             String
  email            String                 @unique
  username         String?                @unique
  passwordHash     String                 @map("password_hash")
  active           Boolean                @default(true)
  roleId           String                 @map("role_id")
  role             Role                   @relation(fields: [roleId], references: [id])
  assignedOrders   Order[]                @relation("AssignedDelivery")
  createdOrders    Order[]                @relation("CreatedOrders")
  containerMoves   ContainerMovement[]
  trabajador       Trabajador?
  // Qué unidades de negocio mira esta persona. Sin filas = todas (ver UsuarioUnidadVisible).
  unidadesVisibles UsuarioUnidadVisible[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@map("users")
}

// Las unidades de negocio que un usuario eligió mirar, en Configuración › Unidades que veo.
//
// Va en la base y no en el navegador porque es una preferencia de la persona, no de la máquina:
// tiene que seguirla si entra desde el celular o desde otra computadora. Antes la elección vivía
// en `localStorage`, así que se perdía al cambiar de equipo y se heredaba entre usuarios de la
// misma máquina.
//
// SIN NINGUNA FILA SIGNIFICA "TODAS", y es el estado por defecto. Eso importa: si se guardaran
// las unidades de hoy una por una, una unidad creada mañana no aparecería y el usuario vería
// números incompletos sin entender por qué.
model UsuarioUnidadVisible {
  userId          String        @map("user_id")
  unidadNegocioId BigInt        @map("unidad_negocio_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  unidadNegocio   UnidadNegocio @relation(fields: [unidadNegocioId], references: [id], onDelete: Cascade)

  @@id([userId, unidadNegocioId])
  @@index([userId])
  @@map("usuario_unidad_visible")
}

model Client {
  id               String              @id @default(cuid())
  name             String
  documentType     String?             @default("DNI") @map("document_type")
  document         String?
  phone            String
  address          String
  reference        String?
  type             ClientType
  active           Boolean             @default(true)
  containerBalance Int                 @default(0) @map("container_balance")
  debtBalance      Decimal             @default(0) @map("debt_balance") @db.Decimal(10, 2)
  orders           Order[]
  containerMoves   ContainerMovement[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([name])
  @@map("clients")
}

model Order {
  id             String              @id @default(cuid())
  clientId       String              @map("client_id")
  createdById    String?             @map("created_by_id")
  deliveryUserId String?             @map("delivery_user_id")
  status         OrderStatus         @default(PENDING)
  observations   String?
  orderedAt      DateTime            @default(now()) @map("ordered_at")
  total          Decimal             @default(0) @db.Decimal(10, 2)
  client         Client              @relation(fields: [clientId], references: [id])
  createdBy      User?               @relation("CreatedOrders", fields: [createdById], references: [id])
  deliveryUser   User?               @relation("AssignedDelivery", fields: [deliveryUserId], references: [id])
  containerMoves ContainerMovement[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

model ContainerMovement {
  id           String                @id @default(cuid())
  // `clientId`/`client` quedan del modelo legacy (Client, sin uso — ver abajo);
  // ahora opcionales porque los movimientos nuevos se registran contra
  // `clienteId`/`cliente` (Cliente, el modelo moderno que usa el resto del
  // sistema). Ningún movimiento existente se pierde: la tabla está vacía.
  clientId     String?               @map("client_id")
  clienteId    BigInt?               @map("cliente_id")
  orderId      String?               @map("order_id")
  // La venta que movió estos envases, cuando el movimiento no se cargó a mano desde la
  // pantalla "Envases". Es lo que permite leer el historial y saber de dónde salió cada
  // línea, y lo que usa la reversión para deshacer exactamente lo que esa venta hizo.
  ventaId      BigInt?               @map("venta_id")
  userId       String?               @map("user_id")
  type         ContainerMovementType
  quantity     Int
  balanceAfter Int                   @map("balance_after")
  notes        String?
  movedAt      DateTime              @default(now()) @map("moved_at")
  client       Client?               @relation(fields: [clientId], references: [id])
  cliente      Cliente?              @relation(fields: [clienteId], references: [id])
  order        Order?                @relation(fields: [orderId], references: [id])
  venta        Venta?                @relation(fields: [ventaId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])

  @@index([movedAt])
  @@index([clienteId])
  @@index([ventaId])
  @@map("container_movements")
}

// Nuevo modelo operativo. Las tablas heredadas de arriba se mantienen de forma
// temporal para que el API actual siga funcionando durante la migracion.

// Unidad de negocio: la operación principal y cada puesto satélite. Las ventas, los gastos,
// los clientes y los almacenes pertenecen a exactamente una unidad y no se cruzan entre sí.
// El catálogo de productos, las categorías de gasto, los proveedores y los métodos de pago
// son compartidos: lo que separa a una unidad de otra son sus números, no sus catálogos.
model UnidadNegocio {
  id                 BigInt   @id @default(autoincrement())
  codigo             String   @unique @db.VarChar(30)
  nombre             String   @unique @db.VarChar(100)
  // La operación principal. Exactamente una fila la tiene en true: la migración crea un
  // índice único parcial que lo garantiza (Prisma no sabe expresarlo con @@unique).
  principal          Boolean  @default(false)
  estado             Boolean  @default(true)
  // Un puesto que solo registra lo que vende y lo que gasta.
  //
  // En false la unidad no lleva stock: sus ventas no descuentan inventario ni generan kardex, y
  // sus devoluciones no reingresan nada. Hace falta porque el stock solo nace de una orden de
  // producción (no hay transferencias ni ajustes ni compras), así que un puesto que no produce
  // no podía vender: la venta fallaba con "Stock insuficiente. Disponible: 0".
  //
  // Es propiedad del LUGAR y no de la persona: el stock cuelga del almacén y el almacén de la
  // unidad, así que la venta tiene que comportarse igual la registre el responsable del puesto
  // o el administrador parado en él. La Principal siempre lo tiene en true (lo garantiza un
  // CHECK en constraints.sql).
  controlaInventario Boolean  @default(true) @map("controla_inventario")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Las únicas seis tablas que llevan la columna. El resto se filtra por relación:
  // CuentaCobrar y SaldoFavorCliente por cliente, PagoCliente por cuentaCobrar.venta,
  // DevolucionVenta por venta, StockAlmacen por almacen, MovimientoInventario por
  // detalles.almacen, ContainerMovement por cliente y OrdenProduccion por su almacén.
  ventas           Venta[]
  gastos           Gasto[]
  clientes         Cliente[]
  almacenes        Almacen[]
  trabajadores     Trabajador[]
  bidonesRotos     BidonRoto[]
  // Quiénes la tienen marcada para mirarla. No es dato del negocio, es preferencia de usuario.
  vistaPorUsuarios UsuarioUnidadVisible[]

  @@map("unidad_negocio")
}

model Trabajador {
  id              BigInt   @id @default(autoincrement())
  userId          String?  @unique @map("user_id")
  // La unidad a la que pertenece la persona. Va acá y no en `User` porque un ADMIN puede
  // registrar operaciones a nombre de otro trabajador: la operación debe quedar en la
  // unidad de ESE trabajador, no en la del admin que la tecleó.
  unidadNegocioId BigInt   @map("unidad_negocio_id")
  tipoDocumento   String   @map("tipo_documento") @db.VarChar(20)
  numeroDocumento String   @unique @map("numero_documento") @db.VarChar(20)
  nombres         String   @db.VarChar(100)
  apellidos       String   @db.VarChar(100)
  telefono        String?  @db.VarChar(20)
  correo          String?  @db.VarChar(150)
  cargo           String   @db.VarChar(100)
  estado          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user                  User?                  @relation(fields: [userId], references: [id])
  unidadNegocio         UnidadNegocio          @relation(fields: [unidadNegocioId], references: [id])
  ventas                Venta[]                @relation("VentasRegistradas")
  // Ventas en las que esta persona autorizó pasar el límite de crédito del cliente.
  creditosAutorizados   Venta[]                @relation("CreditosAutorizados")
  pagosCliente          PagoCliente[]
  devolucionesVenta     DevolucionVenta[]
  almacenesResponsables Almacen[]
  movimientosInventario MovimientoInventario[]
  ordenesProduccion     OrdenProduccion[]
  gastos                Gasto[]                @relation("GastosRegistrados")
  // Gastos de categoría "Pago a trabajador" cuyo beneficiario es este trabajador. Son los
  // pagos que RECIBIÓ, no los que registró: por eso son una relación aparte de `gastos`.
  pagosRecibidos        Gasto[]                @relation("GastosRecibidos")
  bidonesRotos          BidonRoto[]
  conteosInventario     ConteoInventario[]
  metodosPago           MetodoPago[]

  @@index([unidadNegocioId])
  @@map("trabajador")
}

model Proveedor {
  id              BigInt   @id @default(autoincrement())
  ruc             String   @unique @db.VarChar(11)
  razonSocial     String   @map("razon_social") @db.VarChar(150)
  nombreComercial String?  @map("nombre_comercial") @db.VarChar(150)
  telefono        String?  @db.VarChar(20)
  correo          String?  @db.VarChar(150)
  direccion       String?  @db.VarChar(250)
  estado          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  gastos          Gasto[]

  @@index([razonSocial])
  @@map("proveedor")
}

// Los gastos son egresos administrativos/operativos. No representan compras de
// productos y, por tanto, no generan movimientos de inventario ni stock.
model Gasto {
  id              BigInt         @id @default(autoincrement())
  unidadNegocioId BigInt         @map("unidad_negocio_id")
  fecha           DateTime       @default(now()) @db.Date
  concepto        String         @db.VarChar(200)
  // La categoría es una fila de `categoria_gasto`, no un texto suelto: el catálogo es la
  // única fuente del nombre, así que renombrarla se refleja en todos sus gastos.
  categoriaId     BigInt         @map("categoria_id")
  monto           Decimal        @db.Decimal(12, 2)
  comprobante     String?        @db.VarChar(50)
  observaciones   String?
  // Quién REGISTRÓ el gasto (su autor). Se muestra como "Registrado por".
  trabajadorId    BigInt?        @map("trabajador_id")
  // A quién se le PAGA. Solo se usa en los gastos de la categoría "Pago a trabajador":
  // es lo que permite que el pago aparezca en el reporte de ese trabajador.
  beneficiarioId  BigInt?        @map("beneficiario_id")
  proveedorId     BigInt?        @map("proveedor_id")
  metodoPagoId    BigInt?        @map("metodo_pago_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  unidadNegocio   UnidadNegocio  @relation(fields: [unidadNegocioId], references: [id])
  categoria       CategoriaGasto @relation(fields: [categoriaId], references: [id])
  trabajador      Trabajador?    @relation("GastosRegistrados", fields: [trabajadorId], references: [id])
  beneficiario    Trabajador?    @relation("GastosRecibidos", fields: [beneficiarioId], references: [id])
  proveedor       Proveedor?     @relation(fields: [proveedorId], references: [id])
  metodoPago      MetodoPago?    @relation(fields: [metodoPagoId], references: [id])

  @@index([fecha])
  @@index([unidadNegocioId, fecha])
  @@index([categoriaId])
  @@index([proveedorId])
  @@index([trabajadorId, fecha])
  @@index([beneficiarioId, fecha])
  @@map("gasto")
}

model CategoriaGasto {
  id        BigInt   @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  // Categoría fija del sistema: no se puede renombrar ni eliminar desde la UI. Hoy solo
  // la usa "Pago a trabajador", que es la que enlaza el gasto con su beneficiario.
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  gastos    Gasto[]

  @@map("categoria_gasto")
}

// Bitácora de la carga diaria: qué se registró como total de un día (producción, venta por
// categoría de pago, gasto) y qué registro real generó. Es la que dice que un día ya está
// cargado, para no duplicarlo. Las columnas de enlace no llevan FK a propósito: la venta, la
// orden o el gasto viven su vida (se anulan, se editan) y esta fila solo recuerda el origen.
model RegistroDiario {
  id                    BigInt   @id @default(autoincrement())
  unidadNegocioId       BigInt   @map("unidad_negocio_id")
  fecha                 DateTime @db.Date
  // PRODUCCION | VENTA | GASTO
  concepto              String   @db.VarChar(20)
  // Solo en las ventas; 0 en los demás conceptos para que el índice único funcione (los
  // NULL no colisionan en Postgres).
  categoriaMetodoPagoId BigInt   @default(0) @map("categoria_metodo_pago_id")
  monto                 Decimal  @default(0) @db.Decimal(12, 2)
  cantidad              Int      @default(0)
  ventaId               BigInt?  @map("venta_id")
  ordenProduccionId     BigInt?  @map("orden_produccion_id")
  gastoId               BigInt?  @map("gasto_id")
  trabajadorId          BigInt   @map("trabajador_id")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([unidadNegocioId, fecha, concepto, categoriaMetodoPagoId], map: "registro_diario_dia_concepto_key")
  @@index([unidadNegocioId, fecha])
  @@map("registro_diario")
}

// Registro diario de bidones que se rompen. Es solo un conteo operativo: no
// genera movimientos de inventario ni afecta el stock.
model BidonRoto {
  id                     BigInt                @id @default(autoincrement())
  // La unidad va acá y no se hereda del trabajador: a una persona la pueden mover de puesto,
  // y entonces su historial de bidones rotos se mudaría con ella. El registro es un hecho que
  // ocurrió en un puesto concreto. Además `trabajadorId` es opcional, así que heredarla
  // dejaría las filas sin autor fuera de todo listado.
  unidadNegocioId        BigInt                @map("unidad_negocio_id")
  fecha                  DateTime              @default(now()) @db.Date
  cantidad               Int
  observaciones          String?
  trabajadorId           BigInt?               @map("trabajador_id")
  // Qué se rompió y de dónde salió, para poder descontarlo del inventario. Son opcionales
  // porque las roturas anteriores a esta función se anotaron sin esa información, y porque
  // una rotura fuera del almacén (la que se cae del camión) se registra igual sin descontar.
  // `movimientoInventarioId` en null es justamente eso: "quedó anotada, no se descontó".
  productoId             BigInt?               @map("producto_id")
  almacenId              BigInt?               @map("almacen_id")
  movimientoInventarioId BigInt?               @map("movimiento_inventario_id")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  trabajador             Trabajador?           @relation(fields: [trabajadorId], references: [id])
  unidadNegocio          UnidadNegocio         @relation(fields: [unidadNegocioId], references: [id])
  producto               Producto?             @relation(fields: [productoId], references: [id])
  almacen                Almacen?              @relation(fields: [almacenId], references: [id])
  movimientoInventario   MovimientoInventario? @relation(fields: [movimientoInventarioId], references: [id])

  @@index([fecha])
  @@index([unidadNegocioId, fecha])
  @@map("bidon_roto")
}

/// Un conteo físico del inventario de un almacén: la hoja de cuadre que se guardó.
///
/// Existe aunque no haya generado ningún movimiento, porque "conté todo y cuadraba" es
/// información: sin esta tabla, un cuadre perfecto no dejaría rastro. Y guarda el `teorico`
/// de cada posición como SNAPSHOT: recalcularlo después daría el número ya corregido y toda
/// diferencia histórica se vería como cero.
///
/// No lleva `unidadNegocioId`: la hereda del almacén, igual que `StockAlmacen` y
/// `MovimientoInventario`. A diferencia de `BidonRoto`, un conteo siempre tiene un almacén
/// concreto y un autor obligatorio, así que no hay nada que perder al heredarla.
model ConteoInventario {
  id                BigInt                    @id @default(autoincrement())
  almacenId         BigInt                    @map("almacen_id")
  fecha             DateTime                  @db.Date
  /// CONTEO (cuadre contra lo que hay) | CARGA_INICIAL (el inventario de arranque).
  tipo              String                    @db.VarChar(20)
  trabajadorId      BigInt                    @map("trabajador_id")
  /// Cuántas posiciones se ofrecieron y cuántas se llenaron de verdad: mide la cobertura.
  posiciones        Int
  contadas          Int
  diferencias       Int
  unidadesSobrantes Decimal                   @default(0) @map("unidades_sobrantes") @db.Decimal(12, 3)
  unidadesFaltantes Decimal                   @default(0) @map("unidades_faltantes") @db.Decimal(12, 3)
  observaciones     String?
  createdAt         DateTime                  @default(now()) @map("created_at")
  almacen           Almacen                   @relation(fields: [almacenId], references: [id])
  trabajador        Trabajador                @relation(fields: [trabajadorId], references: [id])
  detalles          DetalleConteoInventario[]
  /// Hasta tres: una cabecera por dirección (entradas, salidas) y otra para la carga inicial.
  movimientos       MovimientoInventario[]

  @@index([almacenId, fecha])
  @@index([fecha])
  @@map("conteo_inventario")
}

/// Una posición contada dentro de un cuadre: qué decía el sistema y qué había de verdad.
model DetalleConteoInventario {
  id                 BigInt           @id @default(autoincrement())
  conteoId           BigInt           @map("conteo_id")
  productoId         BigInt           @map("producto_id")
  loteId             BigInt?          @map("lote_id")
  estadoInventarioId BigInt           @map("estado_inventario_id")
  /// El saldo que mostraba el sistema al momento de contar. No se recalcula nunca.
  teorico            Decimal          @db.Decimal(12, 3)
  contado            Decimal          @db.Decimal(12, 3)
  /// Redundante a propósito: el historial ordena y filtra por esto.
  diferencia         Decimal          @db.Decimal(12, 3)
  costoUnitario      Decimal          @map("costo_unitario") @db.Decimal(12, 4)
  /// ROTURA | MERMA | ERROR_DE_CARGA | ROBO | OTRO. Por qué no coincidía.
  motivo             String?          @db.VarChar(30)
  nota               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  conteo             ConteoInventario @relation(fields: [conteoId], references: [id], onDelete: Cascade)
  producto           Producto         @relation(fields: [productoId], references: [id])
  lote               Lote?            @relation(fields: [loteId], references: [id])
  estadoInventario   EstadoInventario @relation(fields: [estadoInventarioId], references: [id])

  @@index([conteoId])
  @@map("detalle_conteo_inventario")
}

model TipoProducto {
  id          BigInt     @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?
  estado      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  productos   Producto[]

  @@map("tipo_producto")
}

model Producto {
  id                      BigInt                        @id @default(autoincrement())
  tipoProductoId          BigInt                        @map("tipo_producto_id")
  codigo                  String                        @unique @db.VarChar(50)
  nombre                  String                        @db.VarChar(150)
  descripcion             String?
  unidadMedida            String                        @map("unidad_medida") @db.VarChar(30)
  capacidadLitros         Decimal?                      @map("capacidad_litros") @db.Decimal(8, 2)
  precioVenta             Decimal                       @map("precio_venta") @db.Decimal(12, 2)
  costoReferencia         Decimal                       @map("costo_referencia") @db.Decimal(12, 2)
  controlaLote            Boolean                       @default(false) @map("controla_lote")
  esRetornable            Boolean                       @default(false) @map("es_retornable")
  stockMinimoGlobal       Decimal                       @default(0) @map("stock_minimo_global") @db.Decimal(12, 3)
  estado                  Boolean                       @default(true)
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  tipoProducto            TipoProducto                  @relation(fields: [tipoProductoId], references: [id])
  lotes                   Lote[]
  detallesVenta           DetalleVenta[]
  detallesDevolucionVenta DetalleDevolucionVenta[]
  stocks                  StockAlmacen[]
  detallesMovimiento      DetalleMovimientoInventario[]
  ordenesComoProducto     OrdenProduccion[]             @relation("ProductoTerminado")
  consumosProduccion      ConsumoOrdenProduccion[]
  detallesConteo          DetalleConteoInventario[]
  bidonesRotos            BidonRoto[]

  @@index([nombre])
  @@map("producto")
}

model Lote {
  id                      BigInt                        @id @default(autoincrement())
  productoId              BigInt                        @map("producto_id")
  codigoLote              String                        @map("codigo_lote") @db.VarChar(50)
  fechaProduccion         DateTime?                     @map("fecha_produccion") @db.Date
  fechaVencimiento        DateTime?                     @map("fecha_vencimiento") @db.Date
  costoUnitario           Decimal                       @map("costo_unitario") @db.Decimal(12, 4)
  estado                  String                        @db.VarChar(20)
  createdAt               DateTime                      @default(now()) @map("created_at")
  producto                Producto                      @relation(fields: [productoId], references: [id])
  detallesVenta           DetalleVenta[]
  detallesDevolucionVenta DetalleDevolucionVenta[]
  stocks                  StockAlmacen[]
  detallesMovimiento      DetalleMovimientoInventario[]
  detallesConteo          DetalleConteoInventario[]
  ordenProduccion         OrdenProduccion?

  @@unique([productoId, codigoLote])
  @@index([fechaVencimiento])
  // Los lotes activos de un producto se consultan al armar cada venta.
  @@index([productoId, estado])
  @@map("lote")
}

// Familia de un método de cobro: YAPE, EFECTIVO, PLIN... Sirve para que puedan
// convivir varios Yape (uno por repartidor) y aun así sumarlos juntos en los reportes.
model CategoriaMetodoPago {
  id                 BigInt       @id @default(autoincrement())
  nombre             String       @unique @db.VarChar(50)
  icono              String?      @db.VarChar(30)
  // Yape o una transferencia no sirven sin el número/cuenta; el efectivo sí.
  requiereReferencia Boolean      @default(false) @map("requiere_referencia")
  estado             Boolean      @default(true)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  metodos            MetodoPago[]

  @@map("categoria_metodo_pago")
}

// Un método concreto: la categoría (Yape) + su referencia (el número) + su dueño.
// `trabajadorId` en null significa que lo puede usar cualquiera (caso típico: Efectivo).
model MetodoPago {
  id           BigInt               @id @default(autoincrement())
  categoriaId  BigInt?              @map("categoria_id")
  // Etiqueta libre opcional ("Yape del negocio"). Si va en null, el nombre visible se arma
  // con categoría + referencia. Se conserva la columna para no perder los nombres actuales.
  nombre       String?              @db.VarChar(50)
  referencia   String?              @db.VarChar(50)
  trabajadorId BigInt?              @map("trabajador_id")
  estado       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")
  categoria    CategoriaMetodoPago? @relation(fields: [categoriaId], references: [id])
  trabajador   Trabajador?          @relation(fields: [trabajadorId], references: [id])
  pagosCliente PagoCliente[]
  gastos       Gasto[]

  @@index([trabajadorId, estado])
  @@index([categoriaId])
  @@map("metodo_pago")
}

model Almacen {
  id                 BigInt                        @id @default(autoincrement())
  unidadNegocioId    BigInt                        @map("unidad_negocio_id")
  codigo             String                        @unique @db.VarChar(30)
  nombre             String                        @db.VarChar(100)
  // Se conserva la columna (nullable) para no perder los valores históricos, pero ya no se
  // pide ni se muestra: un almacén es solo un lugar donde hay stock.
  tipo               String?                       @db.VarChar(20)
  direccion          String?                       @db.VarChar(250)
  responsableId      BigInt?                       @map("responsable_id")
  estado             Boolean                       @default(true)
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  unidadNegocio      UnidadNegocio                 @relation(fields: [unidadNegocioId], references: [id])
  responsable        Trabajador?                   @relation(fields: [responsableId], references: [id])
  ventasOrigen       Venta[]                       @relation("VentasOrigen")
  stocks             StockAlmacen[]
  movimientosOrigen  MovimientoInventario[]        @relation("MovimientosOrigen")
  movimientosDestino MovimientoInventario[]        @relation("MovimientosDestino")
  detallesMovimiento DetalleMovimientoInventario[]
  ordenesInsumos     OrdenProduccion[]             @relation("AlmacenInsumos")
  ordenesTerminados  OrdenProduccion[]             @relation("AlmacenTerminados")
  conteos            ConteoInventario[]
  bidonesRotos       BidonRoto[]

  @@index([unidadNegocioId])
  @@map("almacen")
}

model EstadoInventario {
  id                      BigInt                        @id @default(autoincrement())
  codigo                  String                        @unique @db.VarChar(30)
  nombre                  String                        @db.VarChar(100)
  permiteVenta            Boolean                       @default(true) @map("permite_venta")
  descripcion             String?
  estado                  Boolean                       @default(true)
  stocks                  StockAlmacen[]
  detallesMovimiento      DetalleMovimientoInventario[]
  detallesDevolucionVenta DetalleDevolucionVenta[]
  detallesConteo          DetalleConteoInventario[]

  @@map("estado_inventario")
}

model Cliente {
  id                 BigInt              @id @default(autoincrement())
  unidadNegocioId    BigInt              @map("unidad_negocio_id")
  tipoDocumento      String?             @map("tipo_documento") @db.VarChar(20)
  numeroDocumento    String?             @map("numero_documento") @db.VarChar(20)
  nombreLegal        String              @map("nombre_legal") @db.VarChar(150)
  nombreComercial    String?             @map("nombre_comercial") @db.VarChar(150)
  telefono           String?             @db.VarChar(20)
  correo             String?             @db.VarChar(150)
  direccion          String?             @db.VarChar(250)
  estado             Boolean             @default(true)
  // Saldo de envases pendientes (bidones entregados sin retornar). Antes vivía
  // solo en el modelo legacy `Client`, desconectado de este; acá se mantiene
  // igual que `containerBalance` allá: positivo = el cliente tiene bidones
  // nuestros pendientes de devolver.
  saldoEnvases       Int                 @default(0) @map("saldo_envases")
  // Cuánto se le puede fiar, en soles.
  //
  //   NULL  sin límite de monto. Es lo que quedan todos los clientes ya cargados, así que
  //         nadie cambia de comportamiento el día que esto se despliega.
  //   0     no se le vende a crédito, punto.
  //   > 0   tope de deuda vigente.
  //
  // Ojo: la otra regla del crédito —no fiarle a quien tiene una cuenta vencida— vale SIEMPRE,
  // también con el límite en NULL. El límite es sobre el monto, no sobre la puntualidad.
  limiteCredito      Decimal?            @map("limite_credito") @db.Decimal(12, 2)
  // Cliente que crea el sistema, no una persona: hoy solo "Ventas del día", que recibe las
  // ventas cargadas como totales diarios. No aparece en la lista de clientes ni en los combos.
  sistema            Boolean             @default(false)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  unidadNegocio      UnidadNegocio       @relation(fields: [unidadNegocioId], references: [id])
  ventas             Venta[]
  cuentasCobrar      CuentaCobrar[]
  saldosFavor        SaldoFavorCliente[]
  movimientosEnvases ContainerMovement[]

  // El documento es único dentro de la unidad, no en toda la base: dos unidades pueden
  // tener registrado al mismo cliente por su cuenta. Los NULL no colisionan en los índices
  // únicos de Postgres, así que se siguen admitiendo clientes sin documento.
  @@unique([unidadNegocioId, numeroDocumento])
  @@index([nombreLegal])
  @@index([unidadNegocioId])
  @@map("cliente")
}

model Venta {
  id                    BigInt                 @id @default(autoincrement())
  unidadNegocioId       BigInt                 @map("unidad_negocio_id")
  clienteId             BigInt                 @map("cliente_id")
  almacenOrigenId       BigInt                 @map("almacen_origen_id")
  trabajadorId          BigInt                 @map("trabajador_id")
  fecha                 DateTime               @default(now())
  subtotal              Decimal                @db.Decimal(12, 2)
  igv                   Decimal                @db.Decimal(12, 2)
  descuento             Decimal                @default(0) @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  tipoPago              String                 @map("tipo_pago") @db.VarChar(20)
  metodoPagoInicialId   BigInt?                @map("metodo_pago_inicial_id")
  montoInicial          Decimal                @default(0) @map("monto_inicial") @db.Decimal(12, 2)
  fechaVencimientoPago  DateTime?              @map("fecha_vencimiento_pago") @db.Date
  estado                String                 @db.VarChar(25)
  estadoPago            String                 @default("PENDIENTE") @map("estado_pago") @db.VarChar(20)
  estadoDevolucion      String                 @default("SIN_DEVOLUCION") @map("estado_devolucion") @db.VarChar(25)
  // Envases vacíos que el cliente entregó en el momento de la venta. Se guarda en la venta,
  // y no solo en el movimiento de envases, por dos razones: el formulario de edición lo tiene
  // que precargar, y revertir la venta tiene que saber qué deshacer.
  //
  // Toda venta anterior a esta función queda en 0, que es la verdad disponible: a nadie se le
  // preguntó, y el saldo de envases de esos clientes se venía llevando a mano desde la
  // pantalla "Envases". Inferirlo de `esRetornable` sería inventar datos.
  vaciosRecibidos       Int                    @default(0) @map("vacios_recibidos")
  // Quién autorizó pasar por encima del límite de crédito del cliente, y con qué números.
  // NULL en toda venta que no necesitó excepción, que son casi todas. Existe para que la
  // autorización se pueda mirar después: si no queda anotada, el permiso de excepción es un
  // cheque en blanco.
  creditoAutorizadoPorId BigInt?               @map("credito_autorizado_por_id")
  creditoAutorizadoNota  String?               @map("credito_autorizado_nota")
  observaciones         String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  unidadNegocio         UnidadNegocio          @relation(fields: [unidadNegocioId], references: [id])
  cliente               Cliente                @relation(fields: [clienteId], references: [id])
  almacenOrigen         Almacen                @relation("VentasOrigen", fields: [almacenOrigenId], references: [id])
  trabajador            Trabajador             @relation("VentasRegistradas", fields: [trabajadorId], references: [id])
  creditoAutorizadoPor  Trabajador?            @relation("CreditosAutorizados", fields: [creditoAutorizadoPorId], references: [id])
  detalles              DetalleVenta[]
  cuentaCobrar          CuentaCobrar?
  devoluciones          DevolucionVenta[]
  movimientosInventario MovimientoInventario[]
  movimientosEnvases    ContainerMovement[]

  @@index([fecha])
  // Los reportes filtran por estado + fecha, y el panel del repartidor por trabajador + fecha.
  @@index([estado, fecha])
  @@index([clienteId])
  @@index([trabajadorId, fecha])
  // Casi toda consulta nueva filtra primero por unidad: estos dos replican los de arriba
  // con la unidad al frente.
  @@index([unidadNegocioId, fecha])
  @@index([unidadNegocioId, estado, fecha])
  @@index([creditoAutorizadoPorId])
  @@map("venta")
}

model DetalleVenta {
  id                 BigInt                   @id @default(autoincrement())
  ventaId            BigInt                   @map("venta_id")
  productoId         BigInt                   @map("producto_id")
  loteId             BigInt?                  @map("lote_id")
  cantidad           Decimal                  @db.Decimal(12, 3)
  precioUnitario     Decimal                  @map("precio_unitario") @db.Decimal(12, 2)
  descuento          Decimal                  @default(0) @db.Decimal(12, 2)
  subtotal           Decimal                  @db.Decimal(12, 2)
  createdAt          DateTime                 @default(now()) @map("created_at")
  venta              Venta                    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto           Producto                 @relation(fields: [productoId], references: [id])
  lote               Lote?                    @relation(fields: [loteId], references: [id])
  detallesDevolucion DetalleDevolucionVenta[]

  // Sin estos índices, mostrar una venta o contar cuántas veces se vendió un producto
  // obliga a recorrer la tabla entera.
  @@index([ventaId])
  @@index([productoId])
  @@map("detalle_venta")
}

model CuentaCobrar {
  id               BigInt        @id @default(autoincrement())
  ventaId          BigInt        @unique @map("venta_id")
  clienteId        BigInt        @map("cliente_id")
  montoOriginal    Decimal       @map("monto_original") @db.Decimal(12, 2)
  montoPagado      Decimal       @default(0) @map("monto_pagado") @db.Decimal(12, 2)
  saldoPendiente   Decimal       @map("saldo_pendiente") @db.Decimal(12, 2)
  fechaEmision     DateTime      @map("fecha_emision") @db.Date
  fechaVencimiento DateTime?     @map("fecha_vencimiento") @db.Date
  estado           String        @db.VarChar(20)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  venta            Venta         @relation(fields: [ventaId], references: [id])
  cliente          Cliente       @relation(fields: [clienteId], references: [id])
  pagos            PagoCliente[]

  @@index([estado, fechaVencimiento])
  @@index([clienteId])
  // Cobranzas y el panel consultan seguido "las que todavía deben algo".
  @@index([saldoPendiente])
  @@map("cuenta_cobrar")
}

model PagoCliente {
  id             BigInt       @id @default(autoincrement())
  cuentaCobrarId BigInt       @map("cuenta_cobrar_id")
  metodoPagoId   BigInt       @map("metodo_pago_id")
  trabajadorId   BigInt       @map("trabajador_id")
  fechaPago      DateTime     @default(now()) @map("fecha_pago")
  monto          Decimal      @db.Decimal(12, 2)
  observaciones  String?
  estado         String       @default("CONFIRMADO") @db.VarChar(20)
  // De dónde sale este movimiento de dinero. Sin esta columna no se puede armar la caja del
  // día: el cobro que la propia venta registra al nacer ya está contado en las ventas por
  // método, así que sumarlo de nuevo como cobranza duplicaría la plata.
  //
  //   VENTA     el cobro automático de la venta al registrarse (ver `applyInitialPayments`)
  //   COBRANZA  lo que se cobró después, de una deuda vieja, desde Cobranzas
  //   REEMBOLSO plata que SALIÓ: la devolución en efectivo de una anulación (monto negativo)
  origen            String           @default("COBRANZA") @db.VarChar(20)
  // La anulación que generó este reembolso. Solo lo llevan los de origen REEMBOLSO, y el
  // CHECK de constraints.sql exige que lo tengan: así ningún monto negativo puede aparecer
  // sin decir de dónde salió.
  devolucionVentaId BigInt?          @map("devolucion_venta_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  cuentaCobrar   CuentaCobrar @relation(fields: [cuentaCobrarId], references: [id])
  metodoPago     MetodoPago   @relation(fields: [metodoPagoId], references: [id])
  trabajador     Trabajador   @relation(fields: [trabajadorId], references: [id])
  devolucionVenta DevolucionVenta? @relation(fields: [devolucionVentaId], references: [id])

  @@index([fechaPago])
  @@index([cuentaCobrarId, estado])
  // El reporte de caja por trabajador filtra por fecha y descarta el origen VENTA.
  @@index([fechaPago, origen])
  @@index([devolucionVentaId])
  @@map("pago_cliente")
}

model DevolucionVenta {
  id                    BigInt                   @id @default(autoincrement())
  ventaId               BigInt                   @map("venta_id")
  trabajadorId          BigInt                   @map("trabajador_id")
  fecha                 DateTime                 @default(now())
  motivo                String
  total                 Decimal                  @db.Decimal(12, 2)
  estado                String                   @db.VarChar(20)
  // Por qué existe esta devolución:
  //   COMERCIAL  el cliente devolvió mercadería y se le acredita
  //   ANULACION  la venta se dio de baja entera porque estaba mal, y la plata que se había
  //              cobrado se le devolvió en efectivo, en persona
  //
  // No hay un estado `ANULADA` en `Venta`: anular ES esta devolución. Se hizo así para que
  // deshacer una venta siga el mismo criterio que el resto del sistema —escribir el hecho
  // contrario, no reescribir el original— y para no partir en dos los reportes, que ya netean
  // las devoluciones y filtran las ventas por `estado: 'CONFIRMADA'`.
  tipo                  String                   @default("COMERCIAL") @db.VarChar(20)
  codigo                String                   @unique @db.VarChar(30)
  observaciones         String?
  createdAt             DateTime                 @default(now()) @map("created_at")
  venta                 Venta                    @relation(fields: [ventaId], references: [id])
  trabajador            Trabajador               @relation(fields: [trabajadorId], references: [id])
  detalles              DetalleDevolucionVenta[]
  movimientosInventario MovimientoInventario[]
  saldosFavor           SaldoFavorCliente[]
  // Los reembolsos en efectivo que generó, cuando es una anulación.
  reembolsos            PagoCliente[]

  @@index([fecha])
  @@index([ventaId, estado])
  @@index([tipo])
  @@map("devolucion_venta")
}

model DetalleDevolucionVenta {
  id                  BigInt           @id @default(autoincrement())
  devolucionVentaId   BigInt           @map("devolucion_venta_id")
  detalleVentaId      BigInt           @map("detalle_venta_id")
  productoId          BigInt           @map("producto_id")
  loteId              BigInt?          @map("lote_id")
  cantidad            Decimal          @db.Decimal(12, 3)
  precioUnitario      Decimal          @map("precio_unitario") @db.Decimal(12, 2)
  subtotal            Decimal          @db.Decimal(12, 2)
  estadoDestinoId     BigInt           @map("estado_destino_id")
  reintegraInventario Boolean          @default(true) @map("reintegra_inventario")
  devolucionVenta     DevolucionVenta  @relation(fields: [devolucionVentaId], references: [id], onDelete: Cascade)
  detalleVenta        DetalleVenta     @relation(fields: [detalleVentaId], references: [id])
  producto            Producto         @relation(fields: [productoId], references: [id])
  lote                Lote?            @relation(fields: [loteId], references: [id])
  estadoDestino       EstadoInventario @relation(fields: [estadoDestinoId], references: [id])

  // Cada vez que se muestra una venta se pregunta cuánto de cada línea ya fue devuelto.
  @@index([detalleVentaId])
  @@index([devolucionVentaId])
  @@map("detalle_devolucion_venta")
}

model SaldoFavorCliente {
  id                BigInt          @id @default(autoincrement())
  clienteId         BigInt          @map("cliente_id")
  devolucionVentaId BigInt          @map("devolucion_venta_id")
  montoOriginal     Decimal         @map("monto_original") @db.Decimal(12, 2)
  montoDisponible   Decimal         @map("monto_disponible") @db.Decimal(12, 2)
  estado            String          @default("DISPONIBLE") @db.VarChar(20)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  cliente           Cliente         @relation(fields: [clienteId], references: [id])
  devolucionVenta   DevolucionVenta @relation(fields: [devolucionVentaId], references: [id])

  @@index([clienteId, estado])
  @@map("saldo_favor_cliente")
}

model OrdenProduccion {
  id                         BigInt                   @id @default(autoincrement())
  codigo                     String                   @unique @db.VarChar(30)
  productoId                 BigInt                   @map("producto_id")
  almacenInsumosId           BigInt                   @map("almacen_insumos_id")
  almacenProductoTerminadoId BigInt                   @map("almacen_producto_terminado_id")
  trabajadorId               BigInt                   @map("trabajador_id")
  loteId                     BigInt?                  @unique @map("lote_id")
  codigoLote                 String?                  @map("codigo_lote") @db.VarChar(50)
  fechaVencimiento           DateTime?                @map("fecha_vencimiento") @db.Date
  cantidadPlanificada        Decimal                  @map("cantidad_planificada") @db.Decimal(12, 3)
  cantidadProducida          Decimal                  @default(0) @map("cantidad_producida") @db.Decimal(12, 3)
  costoTotal                 Decimal                  @default(0) @map("costo_total") @db.Decimal(12, 2)
  fechaPlanificada           DateTime                 @map("fecha_planificada") @db.Date
  fechaInicio                DateTime?                @map("fecha_inicio")
  fechaFin                   DateTime?                @map("fecha_fin")
  estado                     String                   @default("COMPLETADA") @db.VarChar(25)
  observaciones              String?
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  producto                   Producto                 @relation("ProductoTerminado", fields: [productoId], references: [id])
  almacenInsumos             Almacen                  @relation("AlmacenInsumos", fields: [almacenInsumosId], references: [id])
  almacenProductoTerminado   Almacen                  @relation("AlmacenTerminados", fields: [almacenProductoTerminadoId], references: [id])
  trabajador                 Trabajador               @relation(fields: [trabajadorId], references: [id])
  lote                       Lote?                    @relation(fields: [loteId], references: [id])
  consumos                   ConsumoOrdenProduccion[]
  movimientosInventario      MovimientoInventario[]

  @@index([estado, fechaPlanificada])
  // El reporte de resumen agrupa la producción por `fechaFin`, no por la fecha planificada.
  @@index([estado, fechaFin])
  @@map("orden_produccion")
}

model ConsumoOrdenProduccion {
  id                  BigInt          @id @default(autoincrement())
  ordenProduccionId   BigInt          @map("orden_produccion_id")
  productoId          BigInt          @map("producto_id")
  cantidadPlanificada Decimal         @map("cantidad_planificada") @db.Decimal(12, 3)
  cantidadConsumida   Decimal         @default(0) @map("cantidad_consumida") @db.Decimal(12, 3)
  costoUnitario       Decimal         @default(0) @map("costo_unitario") @db.Decimal(12, 4)
  createdAt           DateTime        @default(now()) @map("created_at")
  ordenProduccion     OrdenProduccion @relation(fields: [ordenProduccionId], references: [id], onDelete: Cascade)
  producto            Producto        @relation(fields: [productoId], references: [id])

  @@unique([ordenProduccionId, productoId])
  @@map("consumo_orden_produccion")
}

model StockAlmacen {
  id                 BigInt           @id @default(autoincrement())
  productoId         BigInt           @map("producto_id")
  almacenId          BigInt           @map("almacen_id")
  loteId             BigInt?          @map("lote_id")
  estadoInventarioId BigInt           @map("estado_inventario_id")
  cantidad           Decimal          @default(0) @db.Decimal(12, 3)
  cantidadReservada  Decimal          @default(0) @map("cantidad_reservada") @db.Decimal(12, 3)
  stockMinimo        Decimal          @default(0) @map("stock_minimo") @db.Decimal(12, 3)
  stockMaximo        Decimal?         @map("stock_maximo") @db.Decimal(12, 3)
  costoPromedio      Decimal          @default(0) @map("costo_promedio") @db.Decimal(12, 4)
  updatedAt          DateTime         @updatedAt @map("updated_at")
  producto           Producto         @relation(fields: [productoId], references: [id])
  almacen            Almacen          @relation(fields: [almacenId], references: [id])
  lote               Lote?            @relation(fields: [loteId], references: [id])
  estadoInventario   EstadoInventario @relation(fields: [estadoInventarioId], references: [id])

  @@unique([productoId, almacenId, loteId, estadoInventarioId])
  @@index([almacenId, estadoInventarioId])
  // Al vender se busca el stock del producto en un almacén sin saber el lote; el índice
  // único de arriba no sirve para ese caso porque salta el lote.
  @@index([productoId, almacenId, estadoInventarioId])
  @@map("stock_almacen")
}

model MovimientoInventario {
  id                 BigInt                        @id @default(autoincrement())
  fecha              DateTime                      @default(now())
  tipoMovimiento     String                        @map("tipo_movimiento") @db.VarChar(25)
  tipoOperacion      String                        @map("tipo_operacion") @db.VarChar(30)
  almacenOrigenId    BigInt?                       @map("almacen_origen_id")
  almacenDestinoId   BigInt?                       @map("almacen_destino_id")
  ventaId            BigInt?                       @map("venta_id")
  devolucionVentaId  BigInt?                       @map("devolucion_venta_id")
  ordenProduccionId  BigInt?                       @map("orden_produccion_id")
  /// El cuadre que lo generó, cuando el movimiento sale de un conteo físico.
  conteoInventarioId BigInt?                       @map("conteo_inventario_id")
  trabajadorId       BigInt                        @map("trabajador_id")
  estado             String                        @db.VarChar(20)
  numeroReferencia   String?                       @map("numero_referencia") @db.VarChar(50)
  observaciones      String?
  createdAt          DateTime                      @default(now()) @map("created_at")
  almacenOrigen      Almacen?                      @relation("MovimientosOrigen", fields: [almacenOrigenId], references: [id])
  almacenDestino     Almacen?                      @relation("MovimientosDestino", fields: [almacenDestinoId], references: [id])
  venta              Venta?                        @relation(fields: [ventaId], references: [id])
  devolucionVenta    DevolucionVenta?              @relation(fields: [devolucionVentaId], references: [id])
  ordenProduccion    OrdenProduccion?              @relation(fields: [ordenProduccionId], references: [id])
  conteoInventario   ConteoInventario?             @relation(fields: [conteoInventarioId], references: [id])
  trabajador         Trabajador                    @relation(fields: [trabajadorId], references: [id])
  detalles           DetalleMovimientoInventario[]
  bidonesRotos       BidonRoto[]

  @@index([fecha])
  @@index([conteoInventarioId])
  @@index([tipoOperacion, estado])
  // Los movimientos de una venta se buscan al mostrarla, al editarla (para revertir la
  // salida) y en los reportes. Sin estos índices se recorría la tabla completa cada vez.
  @@index([ventaId])
  @@index([ventaId, tipoOperacion, tipoMovimiento, estado])
  @@index([devolucionVentaId])
  @@index([ordenProduccionId])
  // El buscador de la pantalla Kardex filtra por número de referencia.
  @@index([numeroReferencia])
  @@map("movimiento_inventario")
}

model DetalleMovimientoInventario {
  id                 BigInt               @id @default(autoincrement())
  movimientoId       BigInt               @map("movimiento_id")
  productoId         BigInt               @map("producto_id")
  almacenId          BigInt               @map("almacen_id")
  loteId             BigInt?              @map("lote_id")
  estadoInventarioId BigInt               @map("estado_inventario_id")
  direccion          String               @db.VarChar(10)
  cantidad           Decimal              @db.Decimal(12, 3)
  costoUnitario      Decimal              @map("costo_unitario") @db.Decimal(12, 4)
  costoTotal         Decimal              @map("costo_total") @db.Decimal(12, 2)
  saldoAnterior      Decimal              @map("saldo_anterior") @db.Decimal(12, 3)
  saldoPosterior     Decimal              @map("saldo_posterior") @db.Decimal(12, 3)
  createdAt          DateTime             @default(now()) @map("created_at")
  movimiento         MovimientoInventario @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  producto           Producto             @relation(fields: [productoId], references: [id])
  almacen            Almacen              @relation(fields: [almacenId], references: [id])
  lote               Lote?                @relation(fields: [loteId], references: [id])
  estadoInventario   EstadoInventario     @relation(fields: [estadoInventarioId], references: [id])

  @@index([productoId, almacenId, loteId])
  // El kardex de un producto y el detalle de cada movimiento son las consultas más pesadas
  // del sistema; sin estos índices recorren la tabla más grande de la base.
  @@index([movimientoId])
  @@index([productoId, movimientoId])
  // La hoja de cuadre pide "las líneas de este almacén en este día". En los índices de arriba
  // el almacén nunca es la columna líder, así que sin este la consulta recorre todo el ledger.
  @@index([almacenId, productoId])
  @@map("detalle_movimiento_inventario")
}
