# Copia este archivo como `.env` en la VM. El `.env` real NUNCA se sube a Git.

# PostgreSQL administrado por Docker Compose. Usa una contraseña larga formada por caracteres
# seguros para URL (letras, números, guion y guion bajo). Compose construye DATABASE_URL.
POSTGRES_DB=torito_fresh
POSTGRES_USER=torito
POSTGRES_PASSWORD=cambia-por-una-clave-larga-y-unica

# Firma de sesiones. Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-por-una-cadena-aleatoria-de-al-menos-16-caracteres

# Orígenes autorizados por CORS, separados por coma.
WEB_ORIGIN=https://toritofresh.com,https://www.toritofresh.com

# Metadatos públicos de la landing. Se incorporan al construir la imagen web.
NEXT_PUBLIC_SITE_URL=https://toritofresh.com
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999

# Opcional: token de api.decolecta.com para consultar DNI y RUC.
DECOLECTA_API_TOKEN=

# Solo para desarrollo fuera de Docker. Compose ignora este valor y usa el servicio `db`.
DATABASE_URL=postgresql://postgres:tu-clave-local@localhost:5432/torito_fresh?schema=public
# Para desarrollo crea además apps/web/.env.local a partir de apps/web/.env.example.
