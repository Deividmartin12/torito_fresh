# Copia este archivo como `.env` y reemplaza los valores. El `.env` real NUNCA se sube a git.

# Conexión a PostgreSQL: usuario, contraseña, host, puerto y nombre de la base.
DATABASE_URL="postgresql://postgres:tu-contraseña@localhost:5432/torito_fresh?schema=public"

# Clave con la que se firman los tokens de sesión. Debe ser larga y aleatoria.
# Puedes generar una con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Dirección del API que usa la web. Si la web se abre desde otra PC de la red,
# aquí va la IP del servidor (por ejemplo http://192.168.1.50:4070), no localhost.
NEXT_PUBLIC_API_URL="http://localhost:4070"

# Dirección desde la que se abre la web. El API solo acepta peticiones de este origen.
WEB_ORIGIN="http://localhost:3070"
