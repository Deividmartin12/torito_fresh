# Copia este archivo como `.env.local` (no se sube a git).
# Next.js solo lee los .env que están dentro de apps/web, por eso esta variable va aquí
# y no solo en el .env de la raíz del proyecto.
#
# Si la web se abre desde otra PC de la red, pon la IP del servidor donde corre el API,
# por ejemplo: http://192.168.1.50:4070
NEXT_PUBLIC_API_URL="http://localhost:4070"
